<Window x:Class="AccessibleVideoEditor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AccessibleVideoEditor.App"
        Title="ClipScribe"
        Width="1440" Height="900" MinWidth="900" MinHeight="600"
        FontSize="15"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- Icons come from the Segoe icon fonts built into Windows 11 (Fluent) and Windows 10 (MDL2). -->
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- A thick, high-contrast focus outline that low-vision users can find easily. -->
        <Style x:Key="StrongFocus">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="-2" StrokeThickness="3" RadiusX="3" RadiusY="3"
                                   Stroke="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource StrongFocus}" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="2" />
        </Style>

        <Style x:Key="SpokenItem" TargetType="ListBoxItem">
            <Setter Property="AutomationProperties.Name" Value="{Binding Spoken}" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource StrongFocus}" />
        </Style>

        <!-- A panel heading: an icon and a title. The icon is decoration; the title is what screen readers use. -->
        <Style x:Key="PanelHeader" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="8,5" />
        </Style>

        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Margin" Value="3" />
        </Style>

        <Style x:Key="IconText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Menu x:Name="MainMenu" DockPanel.Dock="Top" AutomationProperties.Name="Menu bar" />

        <!-- Ribbon: tabs of icon buttons, like Word and PowerPoint. Arrow keys move between tabs; Tab goes into a tab's buttons. -->
        <TabControl x:Name="Ribbon" DockPanel.Dock="Top" AutomationProperties.Name="Ribbon"
                    Margin="4,2,4,0" Padding="2" />

        <StatusBar DockPanel.Dock="Bottom" AutomationProperties.Name="Status bar">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" AutomationProperties.Name="Last message" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="PlayheadText" AutomationProperties.Name="Playhead" />
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" MinWidth="230" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="360" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="340" MinWidth="240" />
            </Grid.ColumnDefinitions>

            <!-- Left: library with an icon tab strip, like the activity bar in VS Code (Control 1) -->
            <Border Grid.Column="0" Style="{StaticResource Panel}">
                <DockPanel x:Name="LibraryRegion" AutomationProperties.Name="Library">
                    <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE8F1;" />
                            <TextBlock Text="Library" FontWeight="Bold" />
                            <TextBlock Text="  (Ctrl+1)" Opacity="0.7" />
                        </StackPanel>
                    </Border>
                    <WrapPanel x:Name="LibraryButtons" DockPanel.Dock="Top" Margin="4"
                               KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Once" />
                    <TabControl x:Name="LibraryTabs" Margin="4" TabStripPlacement="Left" AutomationProperties.Name="Library" />
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Focusable="False" IsTabStop="False" />

            <!-- Centre: a large preview with the play controls, and the timeline below -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="200" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="320" MinHeight="200" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Panel}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE714;" />
                                <TextBlock Text="Preview" FontWeight="Bold" />
                                <TextBlock Text="  (Ctrl+4)" Opacity="0.7" />
                            </StackPanel>
                        </Border>
                        <!-- Play controls under the picture. Arrow keys move between them. -->
                        <Border DockPanel.Dock="Bottom" Style="{StaticResource PanelHeader}" BorderThickness="0,1,0,0" Padding="4,2">
                            <DockPanel>
                                <TextBlock x:Name="TransportTime" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0" FontSize="16"
                                           AutomationProperties.Name="Playhead time" />
                                <StackPanel x:Name="Transport" Orientation="Horizontal" AutomationProperties.Name="Play controls"
                                            KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Once" />
                            </DockPanel>
                        </Border>
                        <Border x:Name="PreviewRegion" Background="Black" MinHeight="160"
                                Focusable="True" KeyboardNavigation.IsTabStop="True"
                                FocusVisualStyle="{StaticResource StrongFocus}"
                                AutomationProperties.Name="Preview"
                                AutomationProperties.HelpText="The picture. It describes what is on screen at the playhead. Playback and timeline keys work here; P moves the focused picture.">
                            <Image x:Name="PreviewImage" Focusable="False" Stretch="Uniform" RenderOptions.BitmapScalingMode="Linear" AutomationProperties.Name="Preview picture" />
                        </Border>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center" Focusable="False" IsTabStop="False" />

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230" MinWidth="160" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Panel}">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE81E;" />
                                    <Label x:Name="LayersLabel" Content="Layers:" Target="{Binding ElementName=LayersList}" Padding="0" FontWeight="Bold" />
                                    <TextBlock Text="  (Ctrl+5)" Opacity="0.7" />
                                </StackPanel>
                            </Border>
                            <ListBox x:Name="LayersList" BorderThickness="0"
                                     AutomationProperties.Name="Layers"
                                     AutomationProperties.HelpText="Up and Down arrows choose a layer. Left and Right arrows go through its items. Enter goes to the items. F6 moves to the next area."
                                     ItemContainerStyle="{StaticResource SpokenItem}"
                                     IsTextSearchEnabled="False"
                                     SelectionMode="Single">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource IconText}" Text="{Binding Icon}" />
                                            <TextBlock Text="{Binding Display}" TextWrapping="Wrap" MaxWidth="160" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Focusable="False" IsTabStop="False" />

                    <Border Grid.Column="2" Style="{StaticResource Panel}">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE916;" />
                                    <Label x:Name="ItemsLabel" Content="Timeline:" Target="{Binding ElementName=ItemsList}" Padding="0" FontWeight="Bold" />
                                    <TextBlock Text="  (Ctrl+2)" Opacity="0.7" />
                                </StackPanel>
                            </Border>
                            <ListBox x:Name="ItemsList" DockPanel.Dock="Top" BorderThickness="0"
                                     AutomationProperties.Name="Timeline"
                                     AutomationProperties.HelpText="Left and Right arrows move between items. Up and Down change layer. Enter opens item options. F1 or Control H lists every key."
                                     ItemContainerStyle="{StaticResource SpokenItem}"
                                     IsTextSearchEnabled="False"
                                     SelectionMode="Single"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     VirtualizingPanel.IsVirtualizing="False">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="1" CornerRadius="4" Padding="6" Width="190">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource IconText}" FontSize="24" Text="{Binding Icon}" />
                                                <TextBlock Text="{Binding Display}" TextWrapping="Wrap" MaxHeight="60" />
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <!-- All layers along time, for the mouse: click to select, drag to move, drag an end to trim, wheel to zoom.
                                 Keyboard and screen reader users get the same through the Timeline list above. -->
                            <ScrollViewer x:Name="TracksScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Focusable="False">
                                <local:TimelineTracks x:Name="Tracks" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>

            <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Focusable="False" IsTabStop="False" />

            <!-- Right: the inspector, with options for whatever is selected (Control 3) -->
            <Border Grid.Column="4" Style="{StaticResource Panel}">
                <DockPanel x:Name="PropertiesRegion" AutomationProperties.Name="Inspector">
                    <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                        <DockPanel>
                            <TextBlock x:Name="PropertiesIcon" DockPanel.Dock="Left" Style="{StaticResource IconText}" Text="&#xE713;" />
                            <TextBlock x:Name="PropertiesTitle" Text="Inspector" FontWeight="Bold" TextWrapping="Wrap" />
                        </DockPanel>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                        <StackPanel x:Name="PropertiesPanel" Margin="8,4,10,8" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
