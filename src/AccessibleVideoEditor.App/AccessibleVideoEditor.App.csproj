<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>AccessibleVideoEditor</AssemblyName>
    <RootNamespace>AccessibleVideoEditor.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <Description>A screen-reader-first video editor for Windows.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AccessibleVideoEditor.Core\AccessibleVideoEditor.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Sound output for the live preview (MIT licence). Uses the standard Windows audio API, not Windows Media Player. -->
    <PackageReference Include="NAudio.WinMM" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Real recorded sounds, public domain (CC0); see assets/sounds/recordings/CREDITS.md. -->
    <None Include="..\..\assets\sounds\recordings\**\*" LinkBase="Sounds\Recordings" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
