<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>AccessibleVideoEditor</AssemblyName>
    <RootNamespace>AccessibleVideoEditor.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <Description>A screen-reader-first video editor for Windows.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AccessibleVideoEditor.Core\AccessibleVideoEditor.Core.csproj" />
  </ItemGroup>

</Project>
