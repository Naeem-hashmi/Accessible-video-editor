<Window x:Class="AccessibleVideoEditor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Accessible Video Editor"
        Width="1280" Height="800" MinWidth="800" MinHeight="500"
        FontSize="15"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="SpokenItem" TargetType="ListBoxItem">
            <Setter Property="AutomationProperties.Name" Value="{Binding Spoken}" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Margin" Value="2" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Menu x:Name="MainMenu" DockPanel.Dock="Top" AutomationProperties.Name="Menu bar" />

        <StatusBar DockPanel.Dock="Bottom" AutomationProperties.Name="Status bar">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" AutomationProperties.Name="Last message" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="PlayheadText" AutomationProperties.Name="Playhead" />
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="200" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="300" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="330" MinWidth="220" />
            </Grid.ColumnDefinitions>

            <!-- Left: library (Control 1) -->
            <DockPanel x:Name="LibraryRegion" Grid.Column="0" AutomationProperties.Name="Library">
                <TextBlock DockPanel.Dock="Top" Text="Library" FontWeight="Bold" Margin="0,0,0,4" />
                <WrapPanel x:Name="LibraryButtons" DockPanel.Dock="Top" Margin="0,0,0,6" />
                <TabControl x:Name="LibraryTabs" AutomationProperties.Name="Library" />
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Focusable="False" IsTabStop="False" />

            <!-- Centre: preview (Control 4), layers (Control 5) and timeline (Control 2) -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="160" />
                </Grid.RowDefinitions>

                <Border x:Name="PreviewRegion" Grid.Row="0" Background="Black" Height="260" Margin="0,0,0,8"
                        Focusable="True" KeyboardNavigation.IsTabStop="True"
                        FocusVisualStyle="{x:Null}" BorderBrush="DodgerBlue"
                        AutomationProperties.Name="Preview"
                        AutomationProperties.HelpText="The picture. It describes what is on screen at the playhead. Playback and timeline keys work here; P moves the focused picture.">
                    <Image x:Name="PreviewImage" Focusable="False" Stretch="Uniform" RenderOptions.BitmapScalingMode="LowQuality" AutomationProperties.Name="Preview picture" />
                </Border>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230" MinWidth="150" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0">
                        <Label x:Name="LayersLabel" DockPanel.Dock="Top" Content="Layers:" Target="{Binding ElementName=LayersList}" Padding="0,0,0,4" />
                        <ListBox x:Name="LayersList"
                                 AutomationProperties.Name="Layers"
                                 AutomationProperties.HelpText="Up and Down arrows choose a layer. Enter goes to its items. F6 moves to the next area."
                                 ItemContainerStyle="{StaticResource SpokenItem}"
                                 IsTextSearchEnabled="False"
                                 SelectionMode="Single">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Display}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Focusable="False" IsTabStop="False" />

                    <DockPanel Grid.Column="2">
                        <Label x:Name="ItemsLabel" DockPanel.Dock="Top" Content="Timeline:" Target="{Binding ElementName=ItemsList}" Padding="0,0,0,4" />
                        <ListBox x:Name="ItemsList"
                                 AutomationProperties.Name="Timeline"
                                 AutomationProperties.HelpText="Left and Right arrows move between items. Up and Down change layer. Enter opens item options. F1 lists every key."
                                 ItemContainerStyle="{StaticResource SpokenItem}"
                                 IsTextSearchEnabled="False"
                                 SelectionMode="Single"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="False">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="3" Padding="6" Width="200">
                                        <TextBlock Text="{Binding Display}" TextWrapping="Wrap" />
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Grid>
            </Grid>

            <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Focusable="False" IsTabStop="False" />

            <!-- Right: properties of the focused item (Control 3) -->
            <DockPanel x:Name="PropertiesRegion" Grid.Column="4" AutomationProperties.Name="Properties">
                <TextBlock x:Name="PropertiesTitle" DockPanel.Dock="Top" Text="Properties" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,4" />
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel x:Name="PropertiesPanel" Margin="0,0,6,0" />
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
